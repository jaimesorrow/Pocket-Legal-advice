rules_version = '2';

// Firestore security rules for Alaska's Pocket Lawbook.
// Legal-content writes are backend-only. The Android client can read only
// published manifests/content and its own entitlement record.
service cloud.firestore {
  match /databases/{database}/documents {

    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /caseLaw/{document=**} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
                  && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.caseLaw == true
                  && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.expiresAt > request.time;
      allow write: if false;
    }

    // Free-tier verified statute content. Backend-only publication.
    match /statutes/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Version manifest consumed by the Android freshness worker.
    match /legal_content_manifest/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Published legal records. Only records explicitly marked PUBLISHED may
    // be served to clients. Pending/failed validation records remain private.
    match /legal_content/{document=**} {
      allow read: if resource.data.status == "PUBLISHED";
      allow write: if false;
    }

    // Source hashes, change events, and update-run logs are backend-only.
    match /legal_source_state/{document=**} {
      allow read, write: if false;
    }
    match /legal_change_events/{document=**} {
      allow read, write: if false;
    }
    match /legal_update_runs/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
